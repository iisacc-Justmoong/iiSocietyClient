@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(iiSocietySync 0.8.0 CONFIG)
find_dependency(iiAcountManager 0.2.8 CONFIG)
if(NOT IOS AND NOT ANDROID)
    find_dependency(OpenSSL 3 COMPONENTS Crypto)
endif()

check_required_components(iiSocietyClient)

if(APPLE)
    find_dependency(Qt6 6.8.3 EXACT COMPONENTS Concurrent)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/iiSocietyClientTargets.cmake")
